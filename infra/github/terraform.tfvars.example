# Copy to terraform.tfvars and edit for a new deployment. No credentials here.
github_owner         = "YOUR_ACCOUNT_OR_ORGANIZATION"
repository_name      = "YOUR_REPOSITORY"
adopt_existing       = false
configure_pages      = false # Enable after pushing code and creating main.
pages_domain         = null  # GitHub's default domain; set your custom domain later.
pages_https_enforced = false # Enable when the custom-domain certificate is ready.
clarity_project_id   = ""    # Set your own ID to enable analytics.

# Only needed when adopting an existing setup:
existing_pages_branch_policy_id = null
